#!/bin/sh
# Replace the vendored scanner from a reviewed upstream revision.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
revision=${1:-main}
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git init -q "$tmp/upstream"
repository=${CHAINSCANNER_REPOSITORY:-https://github.com/GMWalletApp/ChainScanner.git}
git -C "$tmp/upstream" fetch -q --depth=1 "$repository" "$revision"
commit=$(git -C "$tmp/upstream" rev-parse FETCH_HEAD)
git -C "$tmp/upstream" archive "$commit" > "$tmp/source.tar"
mkdir "$tmp/tree"
tar -xf "$tmp/source.tar" -C "$tmp/tree"
test -f "$tmp/tree/go.mod"
mkdir -p chainscanner
rsync -a --delete "$tmp/tree/" chainscanner/
printf '%s\n' "$commit" > chainscanner.rev
